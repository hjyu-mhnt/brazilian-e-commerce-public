	partition D_Calendar = calculated
		mode: import
		source = ```
				
				VAR _minDate = MIN(F_Orders[order_purchase_timestamp])
				VAR _maxDate = MAX(F_Orders[order_purchase_timestamp])
				VAR _calendar = 
				    CALENDAR(DATE(YEAR(_minDate), 1, 1), DATE(YEAR(_maxDate), 12, 31))
				RETURN
				    ADDCOLUMNS (
				        _calendar,
				        "Year", FORMAT([Date], "YYYY"),
				        "YearNum", YEAR([Date]),
				        "YearMonth", FORMAT([Date], "YYYY-MM"),
				        "MonthYear", FORMAT([Date], "MMM.YYYY"),
				        "YearMthStart", EOMONTH([Date], -1) + 1,
				        "YearMthEnd", EOMONTH([Date], 0),
				        "YearMonthIndex1", (YEAR([Date]) - YEAR(_minDate)) * 12 + MONTH([Date]) - MONTH(_minDate) + 1,
				        "YearMonthIndex2", DATEDIFF(EOMONTH(_maxDate, 0), EOMONTH([Date], 0), MONTH),
				        "Month", FORMAT([Date], "MM"),
				        "MonthName", FORMAT([Date], "MMM"),
				        "MonthNum", MONTH([Date]),
				        "WeekDay", FORMAT([Date], "DDD"),
				        "WeekDayIndex", WEEKDAY([Date], 2),
				        "WeekNum", WEEKNUM([Date], 1),
				        "WeekIndex", (YEAR([Date]) - YEAR(_minDate)) * 52 + WEEKNUM([Date], 1),
				        "WeekStartDate", [Date] - WEEKDAY([Date], 1) + 1,
				        "Qtr", "Q" & FORMAT([Date], "Q"),
				        "YearQtr", FORMAT([Date], "YYYY") & "-Q" & FORMAT([Date], "Q"),
				        "IsEndYear", IF(YEAR([Date]) = YEAR(_maxDate), "Y", "N"),
				        "IsEndDate", IF([Date] = _maxDate, "Y", "N"),
				        "IsEndMth", IF(YEAR([Date]) = YEAR(_maxDate) && MONTH([Date]) = MONTH(_maxDate), "Y", "N"),
				        "IsBeforeEndDate", IF([Date] <= _maxDate, "Y", "N"),
				        "IsBeforeEndMth", IF(EOMONTH([Date], 0) <= EOMONTH(_maxDate, 0), "Y", "N"),
				        "IsCYTD", IF(YEAR([Date]) = YEAR(_maxDate) && [Date] <= _maxDate, "Y", "N"),
				        "IsInYTD_Mth", IF(MONTH([Date]) <= MONTH(_maxDate), "Y", "N"),
				        "IsInYTD_Day", IF([Date] <= DATE(YEAR([Date]), MONTH(_maxDate), DAY(_maxDate)), "Y", "N")
				    )
				```

	annotation PBI_Id = 061dfe7220884051b3d1ed66697b568f

